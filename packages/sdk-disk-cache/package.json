{
  "name": "@moto125/sdk-disk-cache",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Caché disco-first para Moto125Sdk (lecturas por entrada + invalidación en writes)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "echo \"(lint sdk-disk-cache)\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@moto125/api-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
